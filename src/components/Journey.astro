---
// Journey.astro — Interactive life journey section
---

<div class="ji-wrap" id="hero">

  <!-- ══ INTRO OVERLAY ══ -->
  <div class="ji-intro" id="ji-intro">
    <div class="ji-intro-box">
      <p class="ji-hi">hello, i'm</p>
      <h1 class="ji-name">Ritik Rana</h1>
      <p class="ji-role">Software Engineer</p>
      <p class="ji-tagline">From a small village to building software — follow my journey.</p>
      <button class="ji-start-btn" id="ji-start">
        Begin Journey <span class="ji-arr">↓</span>
      </button>
    </div>
  </div>

  <!-- ══ JOURNEY VIEWPORT ══ -->
  <div class="ji-viewport" id="ji-viewport">

    <!-- Sky (colour changes per location) -->
    <div class="ji-sky" id="ji-sky"></div>

    <!-- ── Scrollable 2400px world ── -->
    <div class="ji-world" id="ji-world">

      <!-- Ground -->
      <div class="ji-ground"></div>

      <!-- ╔═══════════════════════════╗
           ║  LOCATION 0 — Harnagla   ║
           ╚═══════════════════════════╝ -->
      <div class="ji-scene" style="left:160px;bottom:80px">
        <div class="ji-tree" style="left:0;--th:65px;--lv:38px;--tc:#2d7d2d"></div>
        <div class="ji-tree" style="left:210px;--th:50px;--lv:30px;--tc:#3a8a3a"></div>
        <div class="ji-tree" style="left:250px;--th:70px;--lv:40px;--tc:#256025"></div>
        <div class="ji-hut" style="left:70px"></div>
        <span class="ji-deco" style="left:50px;bottom:2px;font-size:18px">🌾</span>
        <span class="ji-deco" style="left:160px;bottom:2px;font-size:16px">🌾</span>
      </div>
      <div class="ji-pin" id="pin-0" style="left:310px">
        <span class="ji-pin-dot"></span>
        <span class="ji-pin-lbl">Harnagla</span>
      </div>

      <!-- Road -->
      <div class="ji-road" style="left:330px;width:680px"></div>

      <!-- ╔═══════════════════════════╗
           ║  LOCATION 1 — Rampur     ║
           ╚═══════════════════════════╝ -->
      <div class="ji-scene" style="left:980px;bottom:80px">
        <div class="ji-tree" style="left:0;--th:55px;--lv:32px;--tc:#2d7d2d"></div>
        <div class="ji-school-bldg"></div>
        <div class="ji-flagpole" style="left:194px"></div>
        <div class="ji-tree" style="left:230px;--th:60px;--lv:34px;--tc:#3a8a3a"></div>
      </div>
      <div class="ji-pin" id="pin-1" style="left:1060px">
        <span class="ji-pin-dot"></span>
        <span class="ji-pin-lbl">Rampur</span>
      </div>

      <!-- Road -->
      <div class="ji-road" style="left:1080px;width:680px"></div>

      <!-- ╔═══════════════════════════╗
           ║  LOCATION 2 — Moradabad  ║
           ╚═══════════════════════════╝ -->
      <div class="ji-scene" style="left:1720px;bottom:80px">
        <div class="ji-bldg-bg" style="left:0;width:38px;height:110px"></div>
        <div class="ji-bldg-bg" style="left:48px;width:45px;height:85px"></div>
        <div class="ji-college-bldg" style="left:103px"></div>
        <div class="ji-bldg-bg" style="left:265px;width:40px;height:95px"></div>
        <div class="ji-bldg-bg" style="left:315px;width:30px;height:70px"></div>
      </div>
      <div class="ji-pin" id="pin-2" style="left:1810px">
        <span class="ji-pin-dot"></span>
        <span class="ji-pin-lbl">Moradabad</span>
      </div>

      <!-- ══ Pixel Art Character ══ -->
      <div class="ji-char" id="ji-char" style="left:310px">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 8 12"
             width="56" height="84"
             style="image-rendering:pixelated;image-rendering:crisp-edges;display:block"
             class="ji-char-svg">
          <!-- Red cap -->
          <rect x="2" y="0" width="4" height="1" fill="#e63b22"/>
          <rect x="1" y="1" width="6" height="2" fill="#e63b22"/>
          <!-- White M patch on hat -->
          <rect x="3" y="1" width="2" height="1" fill="#fff" opacity="0.5"/>
          <!-- Skin face -->
          <rect x="1" y="3" width="6" height="2" fill="#fdbf75"/>
          <!-- Eyes -->
          <rect x="1" y="4" width="1" height="1" fill="#2a1000"/>
          <rect x="6" y="4" width="1" height="1" fill="#2a1000"/>
          <!-- Mustache -->
          <rect x="2" y="5" width="4" height="1" fill="#7a3b00"/>
          <!-- Overalls shoulders -->
          <rect x="0" y="5" width="1" height="1" fill="#2244cc"/>
          <rect x="7" y="5" width="1" height="1" fill="#2244cc"/>
          <!-- Body overalls -->
          <rect x="0" y="6" width="8" height="3" fill="#2244cc"/>
          <!-- Chest skin stripe -->
          <rect x="3" y="6" width="2" height="2" fill="#fdbf75"/>
          <!-- Overalls buttons -->
          <rect x="2" y="7" width="1" height="1" fill="#ffd700"/>
          <rect x="5" y="7" width="1" height="1" fill="#ffd700"/>
          <!-- Arms -->
          <rect x="0" y="6" width="1" height="2" fill="#fdbf75"/>
          <rect x="7" y="6" width="1" height="2" fill="#fdbf75"/>
          <!-- Legs standing -->
          <rect x="1" y="9" width="2" height="2" fill="#2244cc" class="ji-leg-l"/>
          <rect x="5" y="9" width="2" height="2" fill="#2244cc" class="ji-leg-r"/>
          <!-- Shoes -->
          <rect x="0" y="11" width="3" height="1" fill="#8B4513"/>
          <rect x="5" y="11" width="3" height="1" fill="#8B4513"/>
        </svg>
      </div>

    </div><!-- end ji-world -->

    <!-- Info card -->
    <div class="ji-card" id="ji-card">
      <span class="ji-card-n" id="ji-n">01 / 03</span>
      <h2 class="ji-card-city" id="ji-city">Harnagla</h2>
      <p class="ji-card-sub" id="ji-sub">My Village · Rampur District</p>
      <p class="ji-card-body" id="ji-body">Born and raised here.</p>
    </div>

    <!-- Keyboard hint -->
    <div class="ji-kbd-hint" id="ji-kbd-hint">
      <kbd>←</kbd><kbd>→</kbd> to navigate
    </div>

    <!-- Navigation arrows -->
    <div class="ji-nav">
      <button class="ji-nb" id="ji-prev" disabled aria-label="Previous">←</button>
      <div class="ji-dots">
        <span class="ji-dot ji-dot-on"></span>
        <span class="ji-dot"></span>
        <span class="ji-dot"></span>
      </div>
      <button class="ji-nb" id="ji-next" aria-label="Next">→</button>
    </div>

    <!-- End CTA (shown at Moradabad) -->
    <div class="ji-end" id="ji-end">
      <a href="#about" class="ji-end-btn">See Portfolio ↓</a>
    </div>

  </div><!-- end ji-viewport -->
</div>

<style>
/* ─── Outer wrapper ─────────────────────────────── */
.ji-wrap {
  position: relative;
  height: 520px;
  overflow: hidden;
  background: rgb(var(--color-fill));
}

/* ─── Intro overlay ──────────────────────────────── */
.ji-intro {
  position: absolute;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgb(var(--color-fill));
  transition: opacity 0.55s ease;
}
.ji-intro.out {
  opacity: 0;
  pointer-events: none;
}

.ji-intro-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.4rem;
  text-align: center;
}

.ji-hi {
  font-size: 0.85rem;
  color: rgb(var(--color-accent));
  margin: 0;
  opacity: 0;
  animation: ji-rise 0.5s ease 0.2s forwards;
}
.ji-name {
  font-size: clamp(2.2rem, 7vw, 3.8rem);
  font-weight: 700;
  color: rgb(var(--color-text-base));
  margin: 0;
  letter-spacing: -0.02em;
  opacity: 0;
  animation: ji-rise 0.5s ease 0.4s forwards;
}
.ji-role {
  font-size: 0.88rem;
  color: rgb(var(--color-text-base));
  opacity: 0;
  margin: 0;
  animation: ji-rise 0.5s ease 0.6s forwards;
}
.ji-tagline {
  font-size: 0.8rem;
  color: rgb(var(--color-text-base));
  opacity: 0;
  margin: 0.4rem 0 1.1rem;
  max-width: 360px;
  animation: ji-rise 0.5s ease 0.8s forwards;
}

.ji-start-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.6rem 1.4rem;
  background: rgb(var(--color-accent));
  color: rgb(var(--color-fill));
  border: none;
  border-radius: 6px;
  font-size: 0.85rem;
  font-weight: 700;
  font-family: inherit;
  cursor: pointer;
  opacity: 0;
  animation: ji-rise 0.5s ease 1.1s forwards;
  transition: opacity 0.15s ease, transform 0.15s ease;
}
.ji-start-btn:hover { opacity: 0.85; transform: translateY(-1px); }

.ji-arr { animation: ji-bounce 1.5s ease-in-out infinite; display: inline-block; }

/* ─── Viewport ───────────────────────────────────── */
.ji-viewport {
  position: absolute;
  inset: 0;
  overflow: hidden;
  opacity: 0;
  transition: opacity 0.5s ease 0.1s;
}
.ji-viewport.on { opacity: 1; }

/* ─── Sky ────────────────────────────────────────── */
.ji-sky {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, #a8d4f5 0%, #d4eaff 100%);
  transition: background 1.2s ease;
}
html[data-theme="dark"] .ji-sky {
  background: linear-gradient(to bottom, #1a2840 0%, #2a3a52 100%) !important;
}

/* ─── Scrollable 2400px world ────────────────────── */
.ji-world {
  position: absolute;
  width: 2400px;
  height: 100%;
  transition: transform 1.05s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ─── Ground ─────────────────────────────────────── */
.ji-ground {
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 80px;
  background: #5a9e3a;
}
.ji-ground::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 9px;
  background: #6ab54a;
}
html[data-theme="dark"] .ji-ground { background: #2a4a1a; }
html[data-theme="dark"] .ji-ground::before { background: #366024; }

/* ─── Road / path ────────────────────────────────── */
.ji-road {
  position: absolute;
  bottom: 72px;
  height: 7px;
  background: repeating-linear-gradient(
    90deg, #c8a850 0, #c8a850 18px, transparent 18px, transparent 28px
  );
  opacity: 0.65;
}

/* ─── Scene container ────────────────────────────── */
.ji-scene { position: absolute; }

/* ─── Trees (CSS drawn) ──────────────────────────── */
.ji-tree {
  position: absolute;
  bottom: 0;
  width: 44px;
}
.ji-tree::before { /* trunk */
  content: '';
  position: absolute;
  width: 7px;
  height: var(--th, 42px);
  background: #8B6914;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}
.ji-tree::after { /* leaves */
  content: '';
  position: absolute;
  width: var(--lv, 32px);
  height: var(--lv, 32px);
  background: var(--tc, #2d7d2d);
  border-radius: 50%;
  bottom: calc(var(--th, 42px) - 12px);
  left: 50%;
  transform: translateX(-50%);
  box-shadow: 0 4px 8px rgba(0,0,0,0.15);
}

/* ─── Hut ────────────────────────────────────────── */
.ji-hut {
  position: absolute;
  bottom: 0;
  width: 70px;
  height: 42px;
  background: #c8a870;
  border-radius: 1px;
}
.ji-hut::before { /* roof */
  content: '';
  position: absolute;
  top: -27px; left: -6px;
  width: 0; height: 0;
  border-left: 41px solid transparent;
  border-right: 41px solid transparent;
  border-bottom: 29px solid #b06030;
}
.ji-hut::after { /* door */
  content: '';
  position: absolute;
  bottom: 0; left: 50%;
  transform: translateX(-50%);
  width: 14px; height: 20px;
  background: #5c3a1e;
  border-radius: 2px 2px 0 0;
}

/* ─── School building ────────────────────────────── */
.ji-school-bldg {
  position: absolute;
  bottom: 0;
  left: 45px;
  width: 140px;
  height: 88px;
  background: #e8dab8;
}
.ji-school-bldg::before { /* school sign band */
  content: 'SCHOOL';
  position: absolute;
  top: 6px; left: 50%;
  transform: translateX(-50%);
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.15em;
  color: rgba(0,0,0,0.35);
  white-space: nowrap;
}
.ji-school-bldg::after { /* windows grid */
  content: '';
  position: absolute;
  width: 16px; height: 16px;
  background: #87ceeb;
  top: 22px; left: 14px;
  border-radius: 1px;
  box-shadow:
    24px 0 0 #87ceeb, 48px 0 0 #87ceeb, 72px 0 0 #87ceeb, 96px 0 0 #87ceeb,
    0 26px 0 #87ceeb, 24px 26px 0 #87ceeb, 48px 26px 0 #87ceeb, 72px 26px 0 #87ceeb, 96px 26px 0 #87ceeb;
}
html[data-theme="dark"] .ji-school-bldg { background: #4a4060; }
html[data-theme="dark"] .ji-school-bldg::after {
  background: #4a7a9b;
  box-shadow:
    24px 0 0 #4a7a9b, 48px 0 0 #4a7a9b, 72px 0 0 #4a7a9b, 96px 0 0 #4a7a9b,
    0 26px 0 #4a7a9b, 24px 26px 0 #4a7a9b, 48px 26px 0 #4a7a9b, 72px 26px 0 #4a7a9b, 96px 26px 0 #4a7a9b;
}

/* ─── Flag pole ──────────────────────────────────── */
.ji-flagpole {
  position: absolute;
  bottom: 0;
  width: 3px;
  height: 75px;
  background: #888;
}
.ji-flagpole::after {
  content: '';
  position: absolute;
  top: 5px; left: 3px;
  width: 20px; height: 13px;
  background: #e63b22;
  clip-path: polygon(0 0, 100% 50%, 0 100%);
}

/* ─── Background buildings ───────────────────────── */
.ji-bldg-bg {
  position: absolute;
  bottom: 0;
  background: #b8b0a0;
}
html[data-theme="dark"] .ji-bldg-bg { background: #383050; }

/* ─── College building (MIT) ─────────────────────── */
.ji-college-bldg {
  position: absolute;
  bottom: 0;
  width: 160px;
  height: 104px;
  background: #e8dcc8;
}
.ji-college-bldg::before { /* pillars */
  content: '';
  position: absolute;
  bottom: 0; left: 8px;
  width: 8px; height: 62px;
  background: #d0bfa8;
  box-shadow: 20px 0 0 #d0bfa8, 40px 0 0 #d0bfa8, 60px 0 0 #d0bfa8,
              80px 0 0 #d0bfa8, 100px 0 0 #d0bfa8, 120px 0 0 #d0bfa8, 136px 0 0 #d0bfa8;
}
.ji-college-bldg::after { /* top cornice + label */
  content: 'MIT';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 22px;
  background: #c8b898;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.2em;
  color: rgba(0,0,0,0.4);
}
html[data-theme="dark"] .ji-college-bldg { background: #4a4878; }
html[data-theme="dark"] .ji-college-bldg::before {
  background: #5a5890;
  box-shadow: 20px 0 0 #5a5890, 40px 0 0 #5a5890, 60px 0 0 #5a5890,
              80px 0 0 #5a5890, 100px 0 0 #5a5890, 120px 0 0 #5a5890, 136px 0 0 #5a5890;
}
html[data-theme="dark"] .ji-college-bldg::after { background: #3e3c68; }

/* ─── Location pin ───────────────────────────────── */
.ji-pin {
  position: absolute;
  bottom: 76px;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
}
.ji-pin-dot {
  display: block;
  width: 10px; height: 10px;
  border-radius: 50%;
  background: rgb(var(--color-accent));
  box-shadow: 0 0 0 3px rgba(var(--color-accent), 0.18);
  transition: all 0.3s ease;
}
.ji-pin.active .ji-pin-dot {
  width: 13px; height: 13px;
  box-shadow: 0 0 0 5px rgba(var(--color-accent), 0.2), 0 0 14px rgba(var(--color-accent), 0.5);
}
.ji-pin-lbl {
  font-size: 0.6rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgb(var(--color-text-base));
  background: rgb(var(--color-fill));
  padding: 1px 5px;
  border-radius: 3px;
  opacity: 0.55;
  white-space: nowrap;
}
.ji-pin.active .ji-pin-lbl { opacity: 0.9; }

/* ─── Emoji decorations ──────────────────────────── */
.ji-deco {
  position: absolute;
  user-select: none;
  line-height: 1;
}

/* ─── Character ──────────────────────────────────── */
.ji-char {
  position: absolute;
  bottom: 80px;
  transform: translateX(-50%);
  transition: left 1.05s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 10;
}
.ji-char.walking .ji-char-svg {
  animation: ji-walk 0.24s ease-in-out infinite;
}
.ji-char.flip .ji-char-svg { transform: scaleX(-1); }

@keyframes ji-walk {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-6px); }
}

/* ─── Info card ──────────────────────────────────── */
.ji-card {
  position: absolute;
  top: 14px;
  left: 50%;
  transform: translateX(-50%) translateY(-12px);
  background: rgb(var(--color-fill));
  border: 1px solid rgb(var(--color-border));
  border-radius: 10px;
  padding: 0.9rem 1.2rem;
  min-width: 220px;
  max-width: 320px;
  z-index: 20;
  box-shadow: 0 10px 28px rgba(0,0,0,0.1);
  opacity: 0;
  transition: opacity 0.4s ease, transform 0.4s ease;
  pointer-events: none;
}
html[data-theme="dark"] .ji-card { box-shadow: 0 10px 28px rgba(0,0,0,0.45); }
.ji-card.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
.ji-card-n {
  display: block;
  font-size: 0.58rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgb(var(--color-accent));
  opacity: 0.7;
  margin-bottom: 0.25rem;
}
.ji-card-city {
  font-size: 1.2rem;
  font-weight: 700;
  color: rgb(var(--color-text-base));
  margin: 0 0 0.15rem;
}
.ji-card-sub {
  font-size: 0.72rem;
  color: rgb(var(--color-accent));
  margin: 0 0 0.45rem;
  opacity: 0.8;
}
.ji-card-body {
  font-size: 0.79rem;
  color: rgb(var(--color-text-base));
  opacity: 0.65;
  line-height: 1.55;
  margin: 0;
}

/* ─── Keyboard hint ──────────────────────────────── */
.ji-kbd-hint {
  position: absolute;
  top: 14px;
  right: 1rem;
  font-size: 0.6rem;
  color: rgb(var(--color-text-base));
  opacity: 0.35;
  display: flex;
  gap: 0.3rem;
  align-items: center;
  z-index: 20;
}
.ji-kbd-hint kbd {
  font-family: inherit;
  font-size: 0.6rem;
  padding: 1px 5px;
  border: 1px solid rgb(var(--color-border));
  border-radius: 3px;
  background: rgb(var(--color-fill));
}

/* ─── Bottom navigation ──────────────────────────── */
.ji-nav {
  position: absolute;
  bottom: 14px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 1rem;
  z-index: 20;
}
.ji-nb {
  width: 38px; height: 38px;
  border: 1px solid rgb(var(--color-border));
  border-radius: 50%;
  background: rgb(var(--color-fill));
  color: rgb(var(--color-text-base));
  font-size: 1rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s ease;
  font-family: inherit;
}
.ji-nb:hover:not(:disabled) {
  border-color: rgb(var(--color-accent));
  color: rgb(var(--color-accent));
}
.ji-nb:disabled { opacity: 0.22; cursor: default; }

.ji-dots { display: flex; gap: 6px; align-items: center; }
.ji-dot {
  width: 6px; height: 6px;
  border-radius: 50%;
  background: rgb(var(--color-text-base));
  opacity: 0.2;
  transition: all 0.2s ease;
}
.ji-dot-on {
  opacity: 1;
  background: rgb(var(--color-accent));
  width: 8px; height: 8px;
  box-shadow: 0 0 6px rgba(var(--color-accent), 0.5);
}

/* ─── End CTA ────────────────────────────────────── */
.ji-end {
  position: absolute;
  bottom: 18px;
  right: 1.5rem;
  z-index: 20;
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.4s ease, transform 0.4s ease;
  pointer-events: none;
}
.ji-end.show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}
.ji-end-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.5rem 1rem;
  background: rgb(var(--color-accent));
  color: rgb(var(--color-fill));
  border-radius: 6px;
  font-size: 0.78rem;
  font-weight: 700;
  text-decoration: none;
  transition: opacity 0.15s ease;
  font-family: inherit;
}
.ji-end-btn:hover { opacity: 0.85; }

/* ─── Keyframes ──────────────────────────────────── */
@keyframes ji-rise {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes ji-bounce {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(5px); }
}

/* ─── Responsive ─────────────────────────────────── */
@media (max-width: 640px) {
  .ji-wrap { height: 460px; }
  .ji-card { min-width: 180px; max-width: calc(100vw - 4rem); padding: 0.75rem 1rem; }
  .ji-card-city { font-size: 1rem; }
  .ji-kbd-hint { display: none; }
}
</style>

<script>
(function () {
  const LOCS = [
    {
      name: 'Harnagla',
      sub: 'My Village · Rampur District',
      body: 'Born and raised here. A small village that gave me big dreams — curiosity, persistence, and the belief that where you start doesn\'t define where you go.',
      charX: 310,
      sky: ['#a8d4f5', '#d4eaff'],
      skyDark: ['#1a2840', '#2a3a52'],
    },
    {
      name: 'Rampur',
      sub: 'Class X & XII · 2016–2020',
      body: 'Moved to Rampur for schooling. Science stream. This is where I first touched a computer and understood — this is what I want to do with my life.',
      charX: 1060,
      sky: ['#b2d8f0', '#d8edf8'],
      skyDark: ['#1e2e42', '#2e3e58'],
    },
    {
      name: 'Moradabad',
      sub: 'B.Tech CSE · MIT · 2020–2024',
      body: 'Studied Computer Science at Moradabad Institute of Technology. Late nights, debugging marathons, and side projects — where code became a craft.',
      charX: 1810,
      sky: ['#c0cee0', '#ddeaf8'],
      skyDark: ['#22283e', '#303858'],
    },
  ];

  let cur = 0;
  let started = false;

  function $(id: string) { return document.getElementById(id); }

  const worldEl  = $('ji-world') as HTMLElement;
  const charEl   = $('ji-char')  as HTMLElement;
  const cardEl   = $('ji-card')  as HTMLElement;
  const skyEl    = $('ji-sky')   as HTMLElement;
  const vpEl     = $('ji-viewport') as HTMLElement;
  const introEl  = $('ji-intro') as HTMLElement;
  const prevBtn  = $('ji-prev')  as HTMLButtonElement;
  const nextBtn  = $('ji-next')  as HTMLButtonElement;
  const endEl    = $('ji-end')   as HTMLElement;
  const dots     = document.querySelectorAll<HTMLElement>('.ji-dot');
  const pins     = document.querySelectorAll<HTMLElement>('.ji-pin');

  function isDark() {
    return document.documentElement.getAttribute('data-theme') === 'dark';
  }

  function pan(locX: number) {
    const vw = vpEl.offsetWidth || window.innerWidth;
    const offset = vw / 2 - locX;
    worldEl.style.transform = `translateX(${offset}px)`;
  }

  function goTo(idx: number) {
    if (idx < 0 || idx >= LOCS.length) return;
    const moving = idx !== cur;
    const goRight = idx > cur;
    cur = idx;
    const loc = LOCS[idx];

    // Move character
    charEl.style.left = loc.charX + 'px';
    if (moving) {
      charEl.classList.toggle('flip', !goRight);
      charEl.classList.add('walking');
      setTimeout(() => charEl.classList.remove('walking'), 1050);
    }

    // Pan world
    pan(loc.charX);

    // Sky colour
    const colors = isDark() ? loc.skyDark : loc.sky;
    skyEl.style.background = `linear-gradient(to bottom, ${colors[0]} 0%, ${colors[1]} 100%)`;

    // Card
    cardEl.classList.remove('show');
    setTimeout(() => {
      ($('ji-n') as HTMLElement).textContent  = `0${idx+1} / 03`;
      ($('ji-city') as HTMLElement).textContent = loc.name;
      ($('ji-sub') as HTMLElement).textContent  = loc.sub;
      ($('ji-body') as HTMLElement).textContent = loc.body;
      cardEl.classList.add('show');
    }, moving ? 520 : 60);

    // Dots
    dots.forEach((d, i) => {
      d.classList.toggle('ji-dot-on', i === idx);
    });

    // Pins
    pins.forEach((p, i) => p.classList.toggle('active', i === idx));

    // Buttons
    prevBtn.disabled = idx === 0;
    nextBtn.disabled = idx === LOCS.length - 1;

    // End CTA
    if (idx === LOCS.length - 1) {
      setTimeout(() => endEl.classList.add('show'), 900);
    } else {
      endEl.classList.remove('show');
    }
  }

  function startJourney() {
    if (started) return;
    started = true;
    introEl.classList.add('out');
    setTimeout(() => {
      introEl.style.display = 'none';
      vpEl.classList.add('on');
      // Set initial world position without animation
      worldEl.style.transition = 'none';
      pan(LOCS[0].charX);
      requestAnimationFrame(() => {
        worldEl.style.transition = '';
        goTo(0);
      });
    }, 580);
  }

  $('ji-start')?.addEventListener('click', startJourney);

  prevBtn?.addEventListener('click', () => goTo(cur - 1));
  nextBtn?.addEventListener('click', () => goTo(cur + 1));

  document.addEventListener('keydown', (e) => {
    if (!started) return;
    if (e.key === 'ArrowRight') goTo(cur + 1);
    if (e.key === 'ArrowLeft')  goTo(cur - 1);
  });

  // Update sky on theme toggle
  const themeBtn = document.getElementById('theme-btn');
  themeBtn?.addEventListener('click', () => {
    setTimeout(() => {
      if (!started) return;
      const loc = LOCS[cur];
      const colors = isDark() ? loc.skyDark : loc.sky;
      skyEl.style.background = `linear-gradient(to bottom, ${colors[0]} 0%, ${colors[1]} 100%)`;
    }, 50);
  });
})();
</script>
