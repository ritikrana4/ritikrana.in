---
import { SITE } from "@config";
import Header from "@components/Header.astro";
import Layout from "./Layout.astro";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}
const { frontmatter } = Astro.props;
const currentYear = new Date().getFullYear();

const projects = [
  {
    id: "tribit",
    year: "2026",
    title: "Tribit",
    description:
      "A native desktop app for visual git worktree management with an embedded AI terminal. Drag-and-drop canvas, multi-repo sidebar, VS Code-style diff viewer, and agent integration with Claude and GitHub Copilot.",
    featured: true,
    size: "large",
    link: "/projects/tribit/",
    external: false,
    linkLabel: "Learn more",
    secondaryLink: "https://github.com/ritikrana4/tribit/releases",
    secondaryLabel: "Download",
  },
  {
    id: "ritik-rana-mcp",
    year: "2026",
    title: "Ritik Rana MCP",
    description:
      "An MCP (Model Context Protocol) server that exposes my bio, experience, projects, and skills as tools. Connect it as a custom connector in Claude to ask questions about me directly in chat.",
    featured: true,
    size: "large",
    link: "https://github.com/ritikrana4/ritik-rana-mcp",
    external: true,
    linkLabel: "View on GitHub",
  },
];
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Header activeNav="projects" />

  <main class="rj-main" id="main-content">
    <div class="rj-proj-container">

      <!-- Page header -->
      <div class="rj-proj-header">
        <h1 class="rj-proj-h1">Projects</h1>
        <p class="rj-proj-sub">Things I've built and shipped.</p>
      </div>

      <!-- Grid -->
      <div class="rj-proj-grid">
        {
          projects.map(project => (
            <a
              href={project.link}
              target={project.external === false ? undefined : "_blank"}
              rel={project.external === false ? undefined : "noopener noreferrer"}
              class={`rj-proj-card${project.size === "large" ? " rj-proj-card-large" : ""}`}
            >
              <div class="rj-proj-top">
                <div class="rj-proj-title-wrap">
                  <h3 class={`rj-proj-title${project.size === "large" ? " rj-proj-title-large" : ""}`}>
                    {project.title}
                  </h3>
                  <span class="rj-proj-year">{project.year}</span>
                </div>
                <svg
                  class="rj-proj-arrow"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <line x1="7" y1="17" x2="17" y2="7" />
                  <polyline points="7 7 17 7 17 17" />
                </svg>
              </div>

              <p class="rj-proj-desc">{project.description}</p>
            </a>
          ))
        }
      </div>

    </div>
  </main>

  <footer class="rj-footer">
    <p>© {currentYear} Ritik Rana</p>
  </footer>
</Layout>

<style>
  .rj-main {
    flex: 1;
    padding-top: 5rem;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .rj-proj-container {
    max-width: 42rem; /* max-w-2xl — match home & experience */
    margin: 0 auto;
    padding-top: 3rem;
    padding-bottom: 5rem;
  }

  .rj-proj-header {
    margin-bottom: 3rem;
  }

  .rj-proj-h1 {
    font-family: "Geist", system-ui, sans-serif;
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: rgb(var(--color-text-base));
    margin: 0 0 1rem 0;
  }

  .rj-proj-sub {
    font-size: 1.125rem;
    line-height: 1.625;
    color: rgb(var(--color-text-muted, var(--color-text-base)));
    margin: 0;
  }

  .rj-proj-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .rj-proj-card {
    display: flex;
    flex-direction: column;
    position: relative;
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid rgb(var(--color-border));
    background: rgb(var(--color-fill));
    text-decoration: none;
    color: inherit;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      background-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .rj-proj-card:hover {
    transform: translateY(-4px);
    border-color: rgba(var(--color-accent), 0.5);
    background: rgba(var(--color-card), 0.5);
    box-shadow: 0 10px 15px -3px rgba(var(--color-accent), 0.05), 0 4px 6px -4px rgba(var(--color-accent), 0.05);
  }

  .rj-proj-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .rj-proj-title-wrap {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .rj-proj-title {
    font-family: "Geist", system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: rgb(var(--color-text-base));
    letter-spacing: -0.01em;
    margin: 0;
    transition: color 0.15s ease;
  }

  .rj-proj-title-large {
    font-size: 1.25rem;
  }

  .rj-proj-card:hover .rj-proj-title {
    color: rgb(var(--color-accent));
  }

  .rj-proj-year {
    font-family: "Geist Mono", monospace;
    font-size: 0.75rem;
    color: rgb(var(--color-text-muted, var(--color-text-base)));
  }

  .rj-proj-arrow {
    width: 1rem;
    height: 1rem;
    color: rgb(var(--color-text-muted, var(--color-text-base)));
    opacity: 0.5;
    flex-shrink: 0;
    transition: opacity 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .rj-proj-card:hover .rj-proj-arrow {
    opacity: 1;
    color: rgb(var(--color-accent));
    transform: translate(2px, -2px);
  }

  .rj-proj-desc {
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgb(var(--color-text-muted, var(--color-text-base)));
    margin: 0;
    flex: 1;
  }

  /* ── Footer ── */
  .rj-footer {
    border-top: 1px solid rgba(var(--color-border), 0.5);
    padding: 2rem 1rem;
    text-align: center;
  }

  .rj-footer p {
    font-size: 0.875rem;
    color: rgb(var(--color-text-muted, var(--color-text-base)));
    margin: 0;
  }

  /* ── Responsive ── */
  @media (min-width: 768px) {
    .rj-proj-container {
      padding-top: 5rem;
    }
    .rj-proj-h1 {
      font-size: 3rem;
      line-height: 1;
    }
    .rj-proj-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .rj-proj-card-large {
      grid-column: span 2;
      grid-row: span 2;
    }
  }
</style>
