---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import { SITE } from "@config";

const currentYear = new Date().getFullYear();

const REPO = "ritikrana4/tribit";
const RELEASES_URL = `https://github.com/${REPO}/releases`;
const REPO_URL = `https://github.com/${REPO}`;

type Asset = {
  name: string;
  browser_download_url: string;
  size: number;
  download_count: number;
};

type Release = {
  tag_name: string;
  name: string;
  html_url: string;
  published_at: string;
  body: string;
  assets: Asset[];
};

let release: Release | null = null;
try {
  const res = await fetch(
    `https://api.github.com/repos/${REPO}/releases/latest`,
    {
      headers: {
        Accept: "application/vnd.github+json",
        "User-Agent": "ritikrana.in-build",
      },
    }
  );
  if (res.ok) {
    release = (await res.json()) as Release;
  }
} catch {
  release = null;
}

type Platform = "macos" | "windows";

const platformMeta: Record<
  Platform,
  { label: string; hint: string; match: RegExp[] }
> = {
  macos: {
    label: "macOS",
    hint: "Apple silicon & Intel",
    match: [/\.dmg$/i, /mac|darwin|osx/i],
  },
  windows: {
    label: "Windows",
    hint: "64-bit installer",
    match: [/\.exe$/i, /\.msi$/i, /win/i],
  },
};

function pickAsset(
  assets: Asset[] | undefined,
  patterns: RegExp[]
): Asset | undefined {
  if (!assets) return undefined;
  for (const pattern of patterns) {
    const hit = assets.find(a => pattern.test(a.name));
    if (hit) return hit;
  }
  return undefined;
}

function formatSize(bytes: number): string {
  if (!bytes) return "";
  const mb = bytes / 1024 / 1024;
  return mb >= 1 ? `${mb.toFixed(1)} MB` : `${(bytes / 1024).toFixed(0)} KB`;
}

const platforms = (Object.keys(platformMeta) as Platform[]).map(key => {
  const meta = platformMeta[key];
  const asset = pickAsset(release?.assets, meta.match);
  return {
    key,
    label: meta.label,
    hint: meta.hint,
    asset,
    href: asset?.browser_download_url ?? RELEASES_URL,
    size: asset ? formatSize(asset.size) : "",
  };
});

const version = release?.tag_name ?? "latest";
const publishedAt = release?.published_at
  ? new Date(release.published_at).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : null;

const features = [
  {
    title: "Visual worktree canvas",
    body: "Drag-and-drop board that lays out every branch, worktree, and open PR side-by-side. No more juggling terminal windows.",
    icon: "canvas",
  },
  {
    title: "Multi-repo sidebar",
    body: "Switch between repositories in a single click. Recent branches, dirty state, and stashes all surfaced without leaving the app.",
    icon: "sidebar",
  },
  {
    title: "VS Code-style diff viewer",
    body: "Inline and split diffs with syntax highlighting powered by Monaco. Stage, unstage, and discard hunks with keyboard shortcuts.",
    icon: "diff",
  },
  {
    title: "Embedded AI terminal",
    body: "A first-class shell with Claude and GitHub Copilot wired in. Ask about a diff, generate a commit message, or run a background agent.",
    icon: "terminal",
  },
  {
    title: "Native performance",
    body: "Go core for git operations, TypeScript UI over Tauri. Cold-start under a second on a modern laptop.",
    icon: "bolt",
  },
  {
    title: "Local-first & private",
    body: "Everything runs on your machine. No telemetry, no account required, no repo indexes leaving your box.",
    icon: "lock",
  },
];

const description =
  "Tribit — a native desktop app for visual git worktree management with an embedded AI terminal. Ship faster across branches without losing context.";
---

<Layout title={`Tribit | ${SITE.title}`} description={description}>
  <Header activeNav="projects" />

  <main class="rj-main" id="main-content">
    <div class="rj-tribit-container">
      <!-- Breadcrumb -->
      <nav class="rj-tribit-crumb" aria-label="Breadcrumb">
        <a href="/projects/" class="rj-tribit-crumb-link">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rj-tribit-crumb-icon" aria-hidden="true">
            <line x1="19" y1="12" x2="5" y2="12" />
            <polyline points="12 19 5 12 12 5" />
          </svg>
          Projects
        </a>
      </nav>

      <!-- Hero -->
      <section class="rj-tribit-hero">
        <div class="rj-tribit-hero-meta">
          <span class="rj-tribit-eyebrow">Desktop · Git · AI</span>
          <span class="rj-tribit-dot" aria-hidden="true"></span>
          <span class="rj-tribit-version" title={`Latest release: ${version}`}>
            {version}
          </span>
          {publishedAt && (
            <>
              <span class="rj-tribit-dot" aria-hidden="true"></span>
              <span class="rj-tribit-version">Released {publishedAt}</span>
            </>
          )}
        </div>

        <h1 class="rj-tribit-h1">Tribit</h1>
        <p class="rj-tribit-tagline">
          A visual git worktree manager with an AI terminal built in.
        </p>
        <p class="rj-tribit-lede">
          Tribit is a native desktop app for developers who run multiple
          branches at once. It gives you a drag-and-drop canvas of your
          worktrees, a VS Code-style diff viewer, and an embedded terminal
          wired into Claude and GitHub Copilot — so you can pair with an agent
          without ever leaving the app.
        </p>

        <!-- Primary CTAs -->
        <div class="rj-tribit-cta-row">
          <a
            class="rj-tribit-btn rj-tribit-btn-primary"
            href={platforms[0].href}
            target="_blank"
            rel="noopener noreferrer"
            download
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rj-tribit-btn-icon" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
            Download for {platforms[0].label}
            {platforms[0].size && (
              <span class="rj-tribit-btn-sub">{platforms[0].size}</span>
            )}
          </a>
          <a
            class="rj-tribit-btn rj-tribit-btn-ghost"
            href={REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="rj-tribit-btn-icon" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 0 0 7.86 10.92c.57.11.78-.25.78-.55 0-.27-.01-1.16-.02-2.11-3.2.7-3.88-1.37-3.88-1.37-.52-1.32-1.28-1.67-1.28-1.67-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.02 11.02 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.62 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.4-5.25 5.68.41.35.78 1.05.78 2.12 0 1.53-.01 2.77-.01 3.14 0 .3.21.67.79.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
            </svg>
            View on GitHub
          </a>
        </div>

        <!-- Platform grid (all three, always visible) -->
        <div class="rj-tribit-platforms">
          {platforms.map(p => (
            <a
              class="rj-tribit-platform"
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
              download={p.asset ? true : undefined}
              aria-label={`Download Tribit for ${p.label}`}
            >
              <div class="rj-tribit-platform-icon" aria-hidden="true">
                {p.key === "macos" && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.05 12.04c-.03-2.86 2.34-4.24 2.44-4.31-1.33-1.95-3.4-2.21-4.14-2.24-1.76-.18-3.44 1.04-4.33 1.04-.9 0-2.28-1.01-3.75-.98-1.93.03-3.7 1.12-4.7 2.84-2 3.48-.51 8.63 1.44 11.46.95 1.38 2.08 2.93 3.55 2.88 1.43-.06 1.97-.92 3.7-.92 1.73 0 2.22.92 3.73.89 1.54-.03 2.51-1.41 3.45-2.79 1.09-1.6 1.54-3.15 1.56-3.23-.03-.02-3-.11-3.03-4.64ZM14.6 3.68c.79-.96 1.32-2.29 1.17-3.61-1.13.05-2.5.75-3.32 1.71-.73.85-1.37 2.22-1.2 3.51 1.26.1 2.55-.64 3.35-1.61Z"/>
                  </svg>
                )}
                {p.key === "windows" && (
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M0 3.5 9.75 2.13v9.37H0V3.5Zm10.88-1.5L24 0v11.5H10.88V2Zm0 10.63H24V24l-13.13-1.85V12.63ZM0 12.63h9.75V22L0 20.5v-7.87Z"/>
                  </svg>
                )}
              </div>
              <div class="rj-tribit-platform-body">
                <div class="rj-tribit-platform-label">{p.label}</div>
                <div class="rj-tribit-platform-hint">
                  {p.asset ? p.hint : "See releases"}
                  {p.size && ` · ${p.size}`}
                </div>
              </div>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rj-tribit-platform-arrow" aria-hidden="true">
                {p.asset ? (
                  <>
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                    <polyline points="7 10 12 15 17 10" />
                    <line x1="12" y1="15" x2="12" y2="3" />
                  </>
                ) : (
                  <>
                    <line x1="7" y1="17" x2="17" y2="7" />
                    <polyline points="7 7 17 7 17 17" />
                  </>
                )}
              </svg>
            </a>
          ))}
        </div>

        <p class="rj-tribit-notice">
          Downloads point at the latest release on GitHub.
          <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer">
            See all releases →
          </a>
        </p>
      </section>

      <!-- What is Tribit -->
      <section class="rj-tribit-section">
        <h2 class="rj-tribit-h2">What is Tribit?</h2>
        <div class="rj-tribit-prose">
          <p>
            Modern development is rarely one branch at a time. You're reviewing
            a colleague's PR, patching a hotfix on <code>main</code>, and
            trying to finish the feature you actually care about — often in the
            same fifteen minutes.
          </p>
          <p>
            Git already has the primitive for this: worktrees. But the tooling
            around them is thin. You end up with three terminals, two editor
            windows, and a stash you'll regret opening tomorrow.
          </p>
          <p>
            Tribit treats worktrees as first-class UI. Each branch is a card on
            a canvas you can drag around. Each card shows its diff, its status,
            its open PR, and gives you a dedicated terminal — with an AI agent
            already in the room. Ship parallel work without losing the plot.
          </p>
        </div>
      </section>

      <!-- Features -->
      <section class="rj-tribit-section">
        <h2 class="rj-tribit-h2">Highlights</h2>
        <div class="rj-tribit-features">
          {features.map(f => (
            <div class="rj-tribit-feature">
              <div class="rj-tribit-feature-icon" aria-hidden="true">
                {f.icon === "canvas" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="7" height="7" rx="1" />
                    <rect x="14" y="3" width="7" height="7" rx="1" />
                    <rect x="3" y="14" width="7" height="7" rx="1" />
                    <rect x="14" y="14" width="7" height="7" rx="1" />
                  </svg>
                )}
                {f.icon === "sidebar" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" />
                    <line x1="9" y1="3" x2="9" y2="21" />
                  </svg>
                )}
                {f.icon === "diff" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 3v18" />
                    <path d="M5 8l-2 4 2 4" />
                    <path d="M19 8l2 4-2 4" />
                  </svg>
                )}
                {f.icon === "terminal" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="4 17 10 11 4 5" />
                    <line x1="12" y1="19" x2="20" y2="19" />
                  </svg>
                )}
                {f.icon === "bolt" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" />
                  </svg>
                )}
                {f.icon === "lock" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                  </svg>
                )}
              </div>
              <h3 class="rj-tribit-feature-title">{f.title}</h3>
              <p class="rj-tribit-feature-body">{f.body}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Bottom CTA -->
      <section class="rj-tribit-final">
        <div class="rj-tribit-final-body">
          <h2 class="rj-tribit-final-title">Give it a try.</h2>
          <p class="rj-tribit-final-sub">
            Free while in beta. Feedback welcome on GitHub.
          </p>
        </div>
        <div class="rj-tribit-final-actions">
          <a
            class="rj-tribit-btn rj-tribit-btn-primary"
            href={platforms[0].href}
            target="_blank"
            rel="noopener noreferrer"
            download
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="rj-tribit-btn-icon" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="7 10 12 15 17 10" />
              <line x1="12" y1="15" x2="12" y2="3" />
            </svg>
            Download {version}
          </a>
          <a
            class="rj-tribit-btn rj-tribit-btn-ghost"
            href={RELEASES_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            All releases
          </a>
        </div>
      </section>
    </div>
  </main>

  <footer class="rj-footer">
    <p>© {currentYear} Ritik Rana</p>
  </footer>
</Layout>

<style>
  .rj-main {
    flex: 1;
    padding-top: 5rem;
    padding-left: 1rem;
    padding-right: 1rem;
  }

  .rj-tribit-container {
    max-width: 42rem; /* match home & experience */
    margin: 0 auto;
    padding-top: 1.5rem;
    padding-bottom: 5rem;
  }

  /* ── Breadcrumb ── */
  .rj-tribit-crumb {
    margin-bottom: 1.5rem;
    margin-left: -0.25rem;
  }
  .rj-tribit-crumb-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.5rem;
    text-decoration: none;
    color: rgb(var(--color-text-muted, var(--color-text-base)));
    font-family: "Geist", system-ui, sans-serif;
    font-size: 0.8125rem;
    font-weight: 500;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .rj-tribit-crumb-link:hover {
    color: rgb(var(--color-text-base));
    background: rgb(var(--color-card));
  }
  .rj-tribit-crumb-icon {
    width: 0.875rem;
    height: 0.875rem;
  }

  /* ── Hero ── */
  .rj-tribit-hero {
    padding-bottom: 4rem;
    border-bottom: 1px solid rgba(var(--color-border), 0.5);
  }

  .rj-tribit-hero-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0.375rem 0.75rem;
    border: 1px solid rgb(var(--color-border));
    border-radius: 999px;
    background: rgb(var(--color-fill));
    margin-bottom: 1.5rem;
  }

  .rj-tribit-eyebrow {
    font-family: "Geist Mono", monospace;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgb(var(--color-accent));
  }

  .rj-tribit-dot {
    width: 3px;
    height: 3px;
    border-radius: 999px;
    background: rgb(var(--color-border));
  }

  .rj-tribit-version {
    font-family: "Geist Mono", monospace;
    font-size: 0.75rem;
    color: rgb(var(--color-text-muted, var(--color-text-base)));
  }

  .rj-tribit-h1 {
    font-family: "Geist", system-ui, sans-serif;
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: rgb(var(--color-text-base));
    margin: 0 0 0.75rem 0;
  }

  .rj-tribit-tagline {
    font-family: "Geist", system-ui, sans-serif;
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: rgb(var(--color-text-base));
    margin: 0 0 1.25rem 0;
  }

  .rj-tribit-lede {
    font-size: 1rem;
    line-height: 1.65;
    color: rgb(var(--color-text-muted, var(--color-text-base)));
    margin: 0 0 2rem 0;
    max-width: 42rem;
  }

  /* ── Buttons ── */
  .rj-tribit-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .rj-tribit-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.125rem;
    border-radius: 0.625rem;
    font-family: "Geist", system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    letter-spacing: -0.005em;
    border: 1px solid transparent;
    transition: transform 0.15s ease, background 0.15s ease,
      border-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
    cursor: pointer;
  }

  .rj-tribit-btn:active {
    transform: translateY(1px);
  }

  .rj-tribit-btn-primary {
    background: rgb(var(--color-text-base));
    color: rgb(var(--color-fill));
    border-color: rgb(var(--color-text-base));
  }

  .rj-tribit-btn-primary:hover {
    box-shadow: 0 6px 16px rgba(var(--color-accent), 0.2);
    opacity: 0.94;
  }

  .rj-tribit-btn-ghost {
    background: rgb(var(--color-fill));
    color: rgb(var(--color-text-base));
    border-color: rgb(var(--color-border));
  }

  .rj-tribit-btn-ghost:hover {
    background: rgb(var(--color-card));
    border-color: rgba(var(--color-accent), 0.4);
  }

  .rj-tribit-btn-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .rj-tribit-btn-sub {
    font-family: "Geist Mono", monospace;
    font-size: 0.6875rem;
    font-weight: 500;
    opacity: 0.7;
    padding-left: 0.25rem;
    border-left: 1px solid currentColor;
    margin-left: 0.25rem;
    padding-block: 0.125rem;
  }

  /* ── Platform grid ── */
  .rj-tribit-platforms {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .rj-tribit-platform {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-radius: 0.75rem;
    border: 1px solid rgb(var(--color-border));
    background: rgb(var(--color-fill));
    text-decoration: none;
    color: inherit;
    transition: transform 0.2s ease, border-color 0.2s ease,
      background 0.2s ease;
  }

  .rj-tribit-platform:hover {
    transform: translateY(-2px);
    border-color: rgba(var(--color-accent), 0.5);
    background: rgba(var(--color-card), 0.6);
  }

  .rj-tribit-platform-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background: rgb(var(--color-card));
    color: rgb(var(--color-text-base));
    flex-shrink: 0;
  }

  .rj-tribit-platform-icon svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .rj-tribit-platform-body {
    flex: 1;
    min-width: 0;
  }

  .rj-tribit-platform-label {
    font-family: "Geist", system-ui, sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    color: rgb(var(--color-text-base));
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .rj-tribit-platform-hint {
    font-family: "Geist Mono", monospace;
    font-size: 0.75rem;
    color: rgb(var(--color-text-muted, var(--color-text-base)));
    margin-top: 0.125rem;
  }

  .rj-tribit-platform-arrow {
    width: 1rem;
    height: 1rem;
    color: rgb(var(--color-text-muted, var(--color-text-base)));
    opacity: 0.6;
    flex-shrink: 0;
    transition: opacity 0.15s ease, color 0.15s ease, transform 0.15s ease;
